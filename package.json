{
  "name": "dining-reservation-bot",
  "version": "1.0.0",
  "description": "Telegram bot for reserving university dining hall meals through the Samad platform",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.19.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\""
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
