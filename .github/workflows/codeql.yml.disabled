#
# Static analysis for the JavaScript/TypeScript security queries: injection paths,
# prototype pollution, unsafe regular expressions and taint flowing into
# dangerous sinks.
#
# Runs alongside the main pipeline rather than inside it, because it needs its own
# permissions and takes longer than the rest of the suite.
#
name: CodeQL

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    # Weekly, so a newly published query still catches what has been sitting there.
    - cron: '23 4 * * 1'

permissions:
  contents: read

jobs:
  analyze:
    name: Analyze
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: javascript-typescript
          # The security-and-quality set adds maintainability rules, which is
          # where the taint-tracking queries for injection live.
          queries: security-and-quality

      - name: Build
        run: npm run build

      - name: Perform the analysis
        uses: github/codeql-action/analyze@v3
        with:
          category: '/language:javascript-typescript'
