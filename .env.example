# ─────────────────────────────────────────────────────────────
#  ربات رزرو غذای سلف دانشگاهی — نمونهٔ متغیرهای محیطی
#  این فایل را به .env کپی کنید و مقدارها را پر کنید.
# ─────────────────────────────────────────────────────────────

# حالت اجرا: production یا development یا test
NODE_ENV=production

# ── تلگرام ───────────────────────────────────────────────────
# توکن ربات، از @BotFather بگیرید. اجباری است.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# آی‌دی عددی ادمین‌ها به شکل آرایهٔ JSON.
# این افراد پیام‌های پشتیبانی را دریافت می‌کنند و می‌توانند پیام همگانی بفرستند.
ADMINS=[123456789]

# آدرس پایهٔ Bot API تلگرام. فقط برای موارد خاص تغییر دهید:
# مثلاً وقتی از سرور محلی Bot API یا یک پروکسی استفاده می‌کنید.
# پیش‌فرض آدرس عمومی ابر تلگرام است.
TELEGRAM_API_ROOT=https://api.telegram.org

# ── پایگاه داده ──────────────────────────────────────────────
# مسیر فایل SQLite. پوشهٔ آن باید روی والیوم داکر باشد تا داده‌ها پایدار بمانند.
DATABASE_PATH=./data/bot.db

# حداکثر زمانی که یک کوئری منتظر آزاد شدن قفل می‌ماند (میلی‌ثانیه)
DB_BUSY_TIMEOUT_MS=5000

# حجم کش صفحه‌های SQLite در حافظه (مگابایت). عدد بزرگ‌تر یعنی خواندن سریع‌تر.
DB_CACHE_MB=64

# حجم نگاشت حافظه‌ای فایل دیتابیس (مگابایت)
DB_MMAP_MB=256

# ── امنیت ────────────────────────────────────────────────────
# کلید اصلی رمزنگاری رمز عبور کاربران. حداقل ۳۲ کاراکتر تصادفی.
# با دستور زیر بسازید:  openssl rand -hex 32
# هشدار: با تغییر این مقدار، رمزهای ذخیره‌شدهٔ قبلی قابل خواندن نیستند.
ENCRYPTION_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# ── نشست و کش ────────────────────────────────────────────────
# مدت اعتبار نشست کاربر در حافظه (دقیقه). بعد از این مدت، کاربر باید دوباره وارد شود.
SESSION_TTL_MINUTES=60

# حداکثر تعداد نشست همزمان در حافظه
SESSION_MAX_ENTRIES=10000

# ── رزرو خودکار ──────────────────────────────────────────────
# زمان اجرای روزانهٔ رزرو خودکار، به وقت تهران.
# قالب cron پنج‌فیلدی: دقیقه ساعت روز ماه هفته
AUTO_RESERVE_CRON=0 7 * * *

# منطقهٔ زمانی فرایند
TZ=Asia/Tehran

# ── رزرو ─────────────────────────────────────────────────────
# چند روز جلوتر یک وعده قابل رزرو می‌شود. سماد وعده‌های نزدیک‌تر را قفل می‌کند،
# پس وعده‌هایی که فاصلهٔ کمتری دارند حتی به کاربر نشان داده نمی‌شوند.
RESERVABLE_DAYS_AHEAD=3

# ── یادآوری اعتبار ───────────────────────────────────────────
# زمان بررسی اعتبار کاربران برای رزروهای پیش‌رو، به وقت تهران.
# اگر موجودی کاربر برای وعده‌های پیش‌رو کافی نباشد، پیام یادآوری می‌گیرد.
CREDIT_CHECK_CRON=0 20 * * *

# ── پشتیبانی: چت‌بات ─────────────────────────────────────────
# کلید OpenRouter. اگر خالی بماند، گزینهٔ چت‌بات به کاربر نشان داده نمی‌شود
# و فقط پشتیبانی انسانی کار می‌کند.
# کلید را از https://openrouter.ai/keys بگیرید.
OPENROUTER_API_KEY=

# آدرس پایهٔ OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# مدل چت‌بات. پیش‌فرض یک مدل رایگان است.
# فهرست مدل‌های رایگان: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# مهلت هر درخواست به OpenRouter (میلی‌ثانیه)
OPENROUTER_TIMEOUT_MS=30000

# حداکثر پیام چت‌بات برای هر کاربر در شبانه‌روز.
# مدل‌های رایگان سهمیهٔ محدودی دارند، پس این سقف لازم است.
CHATBOT_DAILY_LIMIT=20

# چند نوبت گفت‌وگوی قبلی به مدل فرستاده شود
CHATBOT_HISTORY_TURNS=8

# بیشترین طول پرسش کاربر (کاراکتر). متن‌های بلندتر کوتاه می‌شوند تا
# هزینه و حجم ورودی مدل قابل پیش‌بینی بماند.
CHATBOT_MAX_QUESTION_CHARS=500

# بیشترین طول پاسخی که از مدل گرفته و ذخیره می‌شود (کاراکتر)
CHATBOT_MAX_ANSWER_CHARS=2000

# گفت‌وگوهای چت‌بات قدیمی‌تر از این چند روز، در اجرای دوره‌ای نگهداری پاک می‌شوند
CHATBOT_RETENTION_DAYS=90

# ── سرویس سماد ───────────────────────────────────────────────
# مهلت هر درخواست HTTP به سماد (میلی‌ثانیه)
SAMAD_TIMEOUT_MS=15000

# تعداد تلاش مجدد در صورت خطای گذرا
SAMAD_MAX_RETRIES=2

# بررسی زنجیرهٔ گواهی TLS سماد. اگر سماد گواهی ناقصی می‌فرستد که
# مرورگرها می‌پذیرند ولی نود رد می‌کند، این را false کنید.
# هشدار: با false کردن، تأیید گواهی برای ترافیک سماد غیرفعال می‌شود.
SAMAD_TLS_VERIFY=true

# ── سرور سلامت ───────────────────────────────────────────────
# پورت سرویس health و readiness
PORT=3000

# ── لاگ ──────────────────────────────────────────────────────
# یکی از: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# خروجی لاگ به شکل خوانا برای انسان (فقط برای توسعه)
LOG_PRETTY=false
