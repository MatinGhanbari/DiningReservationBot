# ─────────────────────────────────────────────────────────────
#  University dining reservation bot — environment template
#  Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# Runtime mode: production, development or test
NODE_ENV=development

# ── Telegram ─────────────────────────────────────────────────
# Bot token from @BotFather. Required.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Numeric admin ids, as a JSON array.
# These accounts receive support messages and can send broadcasts.
ADMINS=[123456789]

# Base URL of the Telegram Bot API. Change it only for special cases, such as
# pointing at a local Bot API server or a proxy. Defaults to the public cloud
# endpoint.
TELEGRAM_API_ROOT=https://api.telegram.org

# ── Webhook ──────────────────────────────────────────────────
# Public HTTPS address Telegram delivers updates to.
#
# Rule:
#   • NODE_ENV=production and this value set → the bot registers the webhook
#     and Telegram pushes updates to that address itself.
#   • Anything else, including development → any existing webhook is deleted
#     and the bot long-polls. This is why no tunnel is needed on your own
#     machine.
#
# The path of this URL is the webhook route. For example:
#     TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
# means the bot listens on /telegram/webhook.
#
# Notes:
#   • Telegram only accepts ports 443, 80, 88 and 8443.
#   • The webhook and the health server are served on the same port (PORT
#     below), so put it behind a TLS reverse proxy and expose only the webhook
#     path.
#   • Leaving this empty in production sends the bot back to long polling and
#     logs a warning.
TELEGRAM_WEBHOOK_URL=

# The local route the webhook is served on, when a reverse proxy rewrites the
# path before forwarding. Empty means "the path of TELEGRAM_WEBHOOK_URL above",
# which is correct whenever the proxy forwards the path unchanged.
#
# Some gateways strip a prefix: a request to https://host/api/<id>/health is
# forwarded to the bot as /health. Behind one of those, Telegram still posts to
# https://host/api/<id>/ but the bot sees /, so this has to be set to / or the
# delivery lands on a route nothing serves (the server answers 405).
#
# To find out, ask the proxy for a known route and read the body:
#     curl -i https://host/api/<id>/health
# If that returns the bot's own {"status":"ok","uptimeSeconds":...}, the prefix
# is being stripped.
TELEGRAM_WEBHOOK_PATH=

# Webhook secret. Optional, but strongly recommended.
# Telegram echoes this value in the X-Telegram-Bot-Api-Secret-Token header of
# every request, and the bot rejects any request without it. Without it, anyone
# who knows the webhook address can post fake updates.
# Letters, digits, _ and - only, up to 256 characters. Generate one with:
#     openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Storage ──────────────────────────────────────────────────
# The Redis this bot keeps everything in: users, sessions of record, support
# tickets, forget codes, chatbot transcripts. There is no database file.
#
# Password for that Redis. docker-compose passes it to `redis-server` as
# `--requirepass` and builds the bot's connection string from it, so the two can
# never drift apart. The bot itself does not read this variable: it reads
# REDIS_URL, and the password travels inside that URL.
#
# Generate 32 random bytes as hex:
#     openssl rand -hex 32
#
# Hex only, on purpose. `@`, `:`, `/`, `?` and `%` would have to be
# percent-encoded inside REDIS_URL, and `$` is expanded by Docker Compose before
# Redis ever sees it — a hex value needs no escaping in either place. Leave the
# value unquoted, and never reuse a password from another service.
#
# Define it exactly once. Docker Compose reads the *last* occurrence in the file
# (the bot's own loader reads the first), so a leftover duplicate further down
# silently wins and the server and the client end up with different passwords.
#     grep -c '^REDIS_PASSWORD=' .env      # must print 1
REDIS_PASSWORD=

# The Redis this bot keeps everything in.
#
# Put the password in the URL when the server asks for one:
#     redis://:REDIS_PASSWORD@127.0.0.1:6379
# and use `rediss://` when the connection crosses a network you do not control:
# a password sent over plain TCP is readable by anything on the path.
#
# In the bundled docker-compose the service is called `redis`, is not published
# to the host, and REDIS_URL is assembled from REDIS_PASSWORD above — so this
# line only affects a run outside the container.
#
# DURABILITY IS THE SERVER'S JOB. Redis only survives a restart if it is running
# with an append-only file on a persisted volume — which is how the compose file
# configures it. Point this at a plain cache and every account is gone the next
# time the container restarts.
REDIS_URL=redis://127.0.0.1:6379

# Namespace for every key this bot owns. Only matters if the Redis is shared
# with another application. Changing it on a running deployment makes the
# existing data invisible.
REDIS_KEY_PREFIX=drb:

# Where the operator-editable text catalog lives (data/locales/fa.json).
# Not in Redis: it is a file a human edits, and it has to be on a volume for
# those edits to survive a container.
DATA_DIR=./data

# ── Security ─────────────────────────────────────────────────
# Master key for encrypting the stored refresh tokens. At least 64 characters.
# Generate a 96-character key (48 random bytes) with:
#     openssl rand -hex 48
# Longer means more entropy. Never use a short or guessable key.
# Warning: changing this value makes the stored refresh tokens unreadable.
ENCRYPTION_KEY=change-me-to-a-long-random-secret-at-least-64-characters-long-please

# ── Session and cache ────────────────────────────────────────
# How long a user session stays valid in memory (minutes). After that the user
# has to sign in again.
SESSION_TTL_MINUTES=60

# Maximum number of concurrent sessions held in memory
SESSION_MAX_ENTRIES=10000

# ── Auto-reserve ─────────────────────────────────────────────
# Time of the daily auto-reserve run, in Tehran time.
# Five-field cron format: minute hour day-of-month month day-of-week
AUTO_RESERVE_CRON=0 7 * * *

# Process time zone
TZ=Asia/Tehran

# ── Reservation ──────────────────────────────────────────────
# How many days ahead a meal becomes reservable. Samad locks meals closer than
# that, so meals with a shorter lead time are not even shown to the user.
RESERVABLE_DAYS_AHEAD=3

# ── Credit reminder ──────────────────────────────────────────
# Time of the daily credit check for upcoming reservations, in Tehran time.
# A user whose balance does not cover the upcoming meals receives a reminder.
CREDIT_CHECK_CRON=0 20 * * *

# ── Support: chatbot ─────────────────────────────────────────
# OpenRouter API key. If left empty, the chatbot option is hidden from users
# and only human support works.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chatbot model. Defaults to a free model.
# Free models: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Timeout for each OpenRouter request (milliseconds)
OPENROUTER_TIMEOUT_MS=30000

# Maximum chatbot messages per user per day.
# Free models have a limited quota, so a cap is necessary.
CHATBOT_DAILY_LIMIT=20

# How many previous conversation turns are sent to the model
CHATBOT_HISTORY_TURNS=8

# Maximum user question length (characters). Longer text is truncated so the
# cost and input size of the model stay predictable.
CHATBOT_MAX_QUESTION_CHARS=500

# Maximum answer length received from the model and stored (characters)
CHATBOT_MAX_ANSWER_CHARS=2000

# Chatbot conversations older than this many days are deleted by the periodic
# maintenance run
CHATBOT_RETENTION_DAYS=90

# ── Samad upstream ───────────────────────────────────────────
# Note: Samad hosts, routes and headers live in src/config/appsettings.json,
# not here. This section configures the credential, the network behaviour and
# the timeouts.

# The Samad client credential — the value sent in the Authorization header on
# the token request. It is a secret, so this is where it belongs, and not in
# appsettings.json, which git tracks: a value committed once stays readable in
# the repository history even after it is removed from the file.
# Format: Basic <base64 of client_id:client_secret>
# Leaving it empty sends the placeholder from appsettings.json and makes the
# Samad login fail with a 401.
SAMAD_BASIC_AUTH=

# Timeout for each HTTP request to Samad (milliseconds)
SAMAD_TIMEOUT_MS=15000

# Number of retries on a transient error
SAMAD_MAX_RETRIES=2

# Verify Samad's TLS certificate chain. Set it to false if Samad serves an
# incomplete chain that browsers accept but Node rejects.
# Warning: setting it to false disables certificate verification for Samad
# traffic.
SAMAD_TLS_VERIFY=true

# ── Bot copy ─────────────────────────────────────────────────
# Bot language. Only fa is supported for now.
LOCALE=fa

# Directory holding the copy files. Leave empty to place it next to the
# database (in Docker: /app/data/locales). That file can be edited without a
# rebuild.
LOCALES_DIR=

# ── Health server ────────────────────────────────────────────
# Port for the health and readiness endpoints
PORT=3000

# ── Logging ──────────────────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Human-readable log output (development only)
LOG_PRETTY=false
